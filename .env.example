APP_ENV=local
APP_DEBUG=false
APP_BASE_URL=http://localhost/RF/ReconhecimentoFacial-2/public

RFV2_DB_NAME=rf_v2
RFV2_DB_USER=rf_v2_app
RFV2_DB_PASSWORD=substitua-por-uma-senha-longa
RFV2_DB_HOST=127.0.0.1
RFV2_DB_PORT=3306
RFV2_DB_CHARSET=utf8mb4

# Base64 de 32 bytes aleatorios. Gere com: php bin/generate-local-env.php
RFV2_DATA_KEY=gere-uma-chave-criptografica
RFV2_DATA_KEY_ID=local-v1
RFV2_ACCESS_KEY=gere-uma-chave-de-acesso-local

RFV2_FACEAPI_THRESHOLD_SQUARED=0.36
RFV2_FACEAPI_AMBIGUITY_MARGIN_SQUARED=0.01
RFV2_SFACE_THRESHOLD_SQUARED=1.3225
RFV2_SFACE_AMBIGUITY_MARGIN_SQUARED=0.0064
RFV2_VIDEO_INTERVAL_MS=1000

RFV2_IMPORT_MAX_PEOPLE=1000
RFV2_IMPORT_MAX_IMAGES_PER_PERSON=100
RFV2_IMPORT_MAX_FILES=10000
RFV2_IMPORT_MAX_IMAGE_BYTES=5000000
RFV2_IMPORT_MAX_ARCHIVE_BYTES=120000000
RFV2_IMPORT_MAX_UNCOMPRESSED_BYTES=200000000
RFV2_IMPORT_MAX_PIXELS=25000000
RFV2_IMPORT_MIN_DIMENSION=40
RFV2_IMPORT_MAX_COMPRESSION_RATIO=100
# Opcional. Por padrao usa uma pasta exclusiva dentro do diretorio temporario do sistema.
# RFV2_IMPORT_TEMP_ROOT=C:\\caminho-fora-do-document-root\\rfv2-imports

# Futuro servico de visao da arquitetura B; ainda nao e iniciado nesta etapa.
RFV2_PYTHON_HOST=127.0.0.1
RFV2_PYTHON_PORT=8021
RFV2_PYTHON_TOKEN=gere-um-token-interno
RFV2_PYTHON_TIMEOUT_SECONDS=15
